EMAIL_PROVIDER=uol_smtp
EMAIL_FROM_ADDRESS=comercial@firetetraedro.com.br
# Preencha com a URL publica do Fire 360 antes de ativar campanhas.
PUBLIC_APP_URL=
UOL_SMTP_HOST=smtps.uhserver.com
UOL_SMTP_PORT=465
UOL_SMTP_USERNAME=comercial@firetetraedro.com.br
UOL_SMTP_PASSWORD=substitua_por_uma_secret
# Copies are archived separately from SMTP. IMAP credentials default to SMTP.
UOL_SAVE_SENT_COPIES=true
UOL_IMAP_HOST=imap.uhserver.com
UOL_IMAP_PORT=993
# Empty folder means discover the server's existing \\Sent folder.
UOL_SENT_FOLDER=
